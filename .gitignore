# --- Variables de entorno y credenciales ---
# El backend lee la contraseña de PostgreSQL y el secret de JWT desde .env
.env
.env.*
!.env.example
*.pem
*.key

# --- Backend: Java ---
*.class
*.ctxt
hs_err_pid*
replay_pid*

# --- Backend: Gradle ---
.gradle/
**/build/
!**/src/**/build/
gradle-app.setting
.gradletasknamecache

# --- Empaquetados ---
*.jar
*.war
*.ear
# El wrapper de Gradle si se versiona
!**/gradle/wrapper/gradle-wrapper.jar

